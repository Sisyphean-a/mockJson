{
  "name": "mock-console",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/mock-console",
    "packages/chrome-extension"
  ],
  "scripts": {
    "dev": "concurrently \"tsx packages/mock-console/server/src/index.ts\" \"vite --config packages/mock-console/web/vite.config.ts\"",
    "build": "npm run build:mock-console && npm run build:extension",
    "build:mock-console": "vite build --config packages/mock-console/web/vite.config.ts",
    "build:extension": "vite build --config packages/chrome-extension/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "start": "tsx packages/mock-console/server/src/index.ts",
    "test": "node --import tsx --test packages/mock-console/server/src/**/*.test.ts packages/mock-console/web/src/**/*.test.ts packages/chrome-extension/src/**/*.test.ts"
  },
  "dependencies": {
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@fastify/cors": "^10.0.0",
    "@fastify/static": "^10.1.3",
    "codemirror": "^6.0.2",
    "fastify": "^5.0.0",
    "vue": "^3.5.0",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@vitejs/plugin-vue": "^5.2.0",
    "code-inspector-plugin": "^2.0.8",
    "concurrently": "^9.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vue-tsc": "^3.3.11"
  }
}
