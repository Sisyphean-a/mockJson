{
  "manifest_version": 3,
  "name": "Mock Console Browser Mock",
  "version": "0.2.0",
  "description": "Use Mock Console scenarios for page fetch and asynchronous XMLHttpRequest calls, and inspect captured requests in a local panel.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Mock Console Browser Mock",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "devtools_page": "devtools.html",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'self' devtools://devtools http://127.0.0.1:22333 http://localhost:22333 http://127.0.0.1:22334 http://localhost:22334"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocking-manager.html"],
      "matches": ["http://127.0.0.1/*", "http://localhost/*"]
    }
  ],
  "host_permissions": [
    "http://127.0.0.1:22333/*",
    "http://localhost:22333/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://127.0.0.1/*", "http://localhost/*"],
      "js": ["blocking-console-bridge.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "ISOLATED"
    }
  ]
}
